{
  "name": "s1scope",
  "version": "0.1.0",
  "description": "Local viewer for logged decision-model calls (System One API: /v1/systemone). Per-question probability distributions, thresholds, calibration.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "s1scope": "dist/src/cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vite",
    "view": "tsx src/cli.ts view",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.node.json",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@observablehq/plot": "^0.6.19",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.2"
  }
}
